# Preview-friendly environment example (NO SECRETS)
# Copy to .env and fill in credentials as needed.

# Backend HTTP server (backend runs on 3001 in preview)
PORT=3001
HOST=0.0.0.0

# If (and only if) your preview DB is running on a non-standard port (e.g., 3002),
# explicitly opt-in to using it:
DB_USE_PREVIEW_PORT=true
MYSQL_PREVIEW_PORT=3002

# DB connection (use either DB_* or MYSQL_* naming)
# For RDS-like setups, leave DB_PORT unset (defaults to 3306) or set it explicitly to 3306.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USERNAME=admin
DB_PASSWORD=your-db-password
DEFAULT_DB=digitalt3_lms

# Alternatively:
# MYSQL_HOST=127.0.0.1
# MYSQL_PORT=3002
# MYSQL_USER=admin
# MYSQL_PASSWORD=your-db-password
# MYSQL_DB=digitalt3_lms

# Disable SSL for local previews unless you know the preview requires it.
DB_SSL=false

# CORS (adjust to match your frontend origin)
ALLOWED_ORIGINS=http://localhost:3000

# Auth
JWT_SECRET=please-set-a-long-random-secret

# Anthropic (Claude) AI integration (required for /ai/* and /learning-path/*)
ANTHROPIC_API_KEY=your-anthropic-api-key
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022
ANTHROPIC_MAX_TOKENS=1024
