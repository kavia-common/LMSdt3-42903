# Backend preview configuration
# The preview environment expects:
# - backend on port 3001
# - frontend on port 3000

PORT=3001
HOST=0.0.0.0

# CORS configuration
# Prefer setting FRONTEND_URL to your actual preview frontend origin (including scheme + port).
# Example: FRONTEND_URL=http://localhost:3000
FRONTEND_URL=http://localhost:3000

# Optional: comma-separated allowed origins. Use "*" for any origin (not recommended for production).
# ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
ALLOWED_ORIGINS=*

# Optional CORS tuning
ALLOWED_METHODS=GET,POST,PUT,DELETE,PATCH,OPTIONS
ALLOWED_HEADERS=Content-Type,Authorization
CORS_MAX_AGE=600
TRUST_PROXY=true

# Notes on base paths:
# - Routes are mounted at both "/" and "/api"
# - Health routes:
#   - GET /health
#   - GET /api/health
# - Swagger:
#   - GET /openapi.json
#   - UI at /docs and /api-docs
#
# DB settings (canonical variables for RDS / production):
#   DB_HOST, DB_PORT (optional; defaults to 3306), DB_USERNAME, DB_PASSWORD, DEFAULT_DB
#
# Back-compat alternatives also supported:
#   MYSQL_HOST, MYSQL_PORT, MYSQL_USER, MYSQL_PASSWORD, MYSQL_DB
#   RDS_HOSTNAME, RDS_PORT, RDS_USERNAME, RDS_PASSWORD, RDS_DB_NAME
#
# SSL:
#   DB_SSL=true (default) for RDS-safe behavior; set DB_SSL=false for local non-TLS MySQL.
#   Optionally provide DB_SSL_CA_PATH to an RDS CA bundle (default: ./global-bundle.pem).
#
# Preview safety:
#   If the platform injects MYSQL_PREVIEW_PORT, it will NOT override DB_PORT unless you opt-in:
#     DB_USE_PREVIEW_PORT=true
